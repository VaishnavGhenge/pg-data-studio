{
  "name": "pg-data-studio",
  "productName": "PG Data Studio",
  "version": "0.1.0-beta.1",
  "description": "A simple, fast Postgres data viewer and editor — browse tables, edit cells, commit changes.",
  "author": "Vaishnav Ghenge <vaishnavghenge@gmail.com>",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -b tsconfig.node.json tsconfig.web.json",
    "test": "node --test tests/*.test.cjs",
    "format": "prettier --write src tests *.json *.ts README.md",
    "format:check": "prettier --check src tests *.json *.ts README.md",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --publish never",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "dev.vaishnav.pgdatastudio",
    "productName": "PG Data Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "artifactName": "${name}-${version}-${arch}.${ext}"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "pg": "^8.13.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "vite": "^7.3.6"
  }
}
